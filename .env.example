# Copy to .env and fill in from Supabase: Project Settings > API.
# Only the public key goes here (sb_publishable_... or the legacy "anon" key).
# Never put the service_role / secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
